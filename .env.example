# Copy to .env.local and fill in. .env.local is gitignored — the secret key
# must never be committed.
#
# Supabase dashboard → Project Settings → API Keys.

# Safe in the browser. Shown as "Project URL" on the same page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Server only. Bypasses Row Level Security — full read/write on every table.
# Never rename this with a NEXT_PUBLIC_ prefix: Next.js inlines anything with
# that prefix into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin page. Pick anything long.
ADMIN_PASSWORD=

# Contact form. The Resend key is the same one the music site uses.
RESEND_API_KEY=
CONTACT_EMAIL=
